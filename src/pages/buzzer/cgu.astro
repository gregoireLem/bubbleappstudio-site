---
import SimpleLayout from "../../layouts/SimpleLayout.astro";

const description = "Terms of Use for Buzzer Battle.";
---

<SimpleLayout title="Terms of Use | Buzzer Battle" description={description} robots="index, follow">
  <main id="main" class="legal-page">
    <article class="legal-card">
      <p class="legal-kicker">Buzzer Battle</p>
      <h1>Terms of Use</h1>
      <p class="legal-date">Last updated: February 5, 2026</p>

      <h2>1. Publisher</h2>
      <p>Bubble App Studio — contact@bubbleappstudio.xyz</p>

      <h2>2. App access</h2>
      <p>The app is provided “as is”. You agree to use it in compliance with applicable laws.</p>

      <h2>3. In‑app purchases</h2>
      <p>
        The app offers Premium access via two options:
      </p>
      <ul>
        <li><strong>Premium Lifetime</strong>: one‑time purchase, no auto‑renewal.</li>
        <li><strong>Premium Monthly</strong>: monthly subscription with auto‑renewal.</li>
      </ul>
      <p>
        Payment is charged to your Apple ID account. The monthly subscription renews automatically unless canceled
        at least 24 hours before the end of the current period. You can manage or cancel your subscription in
        App Store settings. If you cancel, access remains active until the end of the paid period. Prices are shown
        in the app and on the App Store payment sheet.
      </p>
      <p>Refunds are handled by Apple under its own terms.</p>

      <h2>4. License</h2>
      <p>
        Your use is also subject to Apple’s standard EULA:
        <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/" rel="noreferrer" target="_blank">
          Standard EULA
        </a>.
      </p>

      <h2>5. Privacy</h2>
      <p>The privacy policy is available at <a href="/buzzer/privacy">/buzzer/privacy</a>.</p>

      <h2>6. Changes</h2>
      <p>We may update these terms at any time. The online version prevails.</p>
    </article>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(700px 500px at 50% 0%, rgba(251, 234, 78, 0.12), transparent 65%),
        #050505;
    }

    :global(body)::before {
      opacity: 0.08;
    }

    .legal-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: clamp(28px, 6vw, 72px);
    }

    .legal-card {
      width: min(860px, 100%);
      background: rgba(10, 10, 10, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: clamp(24px, 4vw, 48px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    }

    .legal-kicker {
      text-transform: uppercase;
      letter-spacing: 0.32em;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.6);
      margin: 0 0 12px;
    }

    .legal-date {
      color: rgba(255, 255, 255, 0.6);
      margin-top: 0;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(32px, 5vw, 48px);
      margin: 0 0 8px;
      font-family: "SF Pro Display", "SF Pro Text", -apple-system, BlinkMacSystemFont,
        "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 700;
    }

    h2 {
      margin-top: 28px;
      margin-bottom: 8px;
      font-size: 1.1rem;
      color: #f7f1d6;
    }

    p,
    li {
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.6;
    }

    ul {
      padding-left: 20px;
      margin-top: 8px;
      margin-bottom: 16px;
    }

    a {
      color: #fbea4e;
      text-underline-offset: 4px;
    }
  </style>
</SimpleLayout>
