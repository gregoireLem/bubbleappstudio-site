---
import BombPlayExperience from "../../components/BombPlayExperience";
import SimpleLayout from "../../layouts/SimpleLayout.astro";

const description =
  "Bomb Play is a luxurious two-player web version of Password game: duel, built for fast clues, quick guesses and a floral perfume-style finale.";
---

<SimpleLayout
  title="Bomb Play | Bubble App Studio"
  description={description}
  themeColor="#6200FF"
  lang="en"
  locale="en_US"
  colorScheme="dark"
  ogImage="/assets/wolfo.png"
>
  <BombPlayExperience client:load />

  <style>
    :global(body) {
      background:
        radial-gradient(900px 540px at 50% 0%, rgba(98, 0, 255, 0.35), transparent 48%),
        linear-gradient(180deg, #6200ff 0%, #2e0099 38%, #2e0099 62%, #6200ff 100%);
      color: #ffffff;
    }

    :global(body)::before {
      opacity: 0.12;
      mix-blend-mode: soft-light;
    }

    :global(::selection) {
      background: rgba(216, 255, 0, 0.35);
      color: #ffffff;
    }
  </style>
</SimpleLayout>
