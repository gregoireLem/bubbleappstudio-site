---
import BlogPage from '../../../components/BlogPage.astro';
import { posts } from '../../../lib/blog';
export function getStaticPaths() {
  return posts.filter(post => post.frontmatter.locale !== 'fr').map(post => ({ params: { locale: post.frontmatter.locale, slug: post.frontmatter.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogPage locale={post.frontmatter.locale} post={post} />
