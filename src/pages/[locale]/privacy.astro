---
import LegalPage from "../../components/LegalPage.astro";
import {
  defaultLocale,
  locales,
  privacyPageContent
} from "../../i18n/site";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
---

<LegalPage locale={locale} path="/privacy" content={privacyPageContent[locale]} />
