---
import SimpleLayout from "../layouts/SimpleLayout.astro";

const description = "Password game : duel, the TV-style word duel game on your phone.";
const appStoreUrl = "https://apps.apple.com/app/id6762822222";
---

<SimpleLayout
  title="Password game : duel | Bubble App Studio"
  description={description}
  themeColor="#12002b"
>
  <main id="main" class="password-page">
    <section class="password-hero" aria-labelledby="password-title">
      <div class="password-copy">
        <p class="password-kicker">Bubble App Studio</p>
        <h1 id="password-title">Password game : duel</h1>
        <p class="password-subtitle">The TV-style word duel game on your phone.</p>
        <p class="password-description">
          Hold the phone, record both players, and race to guess as many passwords as possible in 30 seconds.
          One clue, one answer, back and forth until the password is found.
        </p>

        <div class="password-actions">
          <a class="password-cta" href={appStoreUrl} target="_blank" rel="noreferrer">
            View on App Store
          </a>
          <a class="password-link" href="/password-game/privacy">Privacy policy</a>
        </div>
      </div>

      <div class="password-showcase" aria-label="Password game : duel App Store screenshots">
        <div class="password-gallery-shell">
          <div class="password-gallery-topline">
            <p>App Store screenshots</p>
            <span>Swipe</span>
          </div>
          <div
            class="password-gallery"
            data-password-gallery
            tabindex="0"
            aria-label="Swipe horizontally to view all screenshots"
          >
            <figure class="password-shot-card">
              <img
                class="password-shot"
                src="/assets/password-game/screenshot-connected.jpg"
                alt="Password game : duel gameplay screenshot showing two camera feeds and the word SpongeBob"
                width="416"
                height="900"
                loading="lazy"
              />
              <figcaption>Dual camera gameplay</figcaption>
            </figure>
            <figure class="password-shot-card">
              <img
                class="password-shot"
                src="/assets/password-game/screenshot-timer.jpg"
                alt="Password game : duel gameplay screenshot showing a 30 second round"
                width="416"
                height="900"
                loading="eager"
              />
              <figcaption>30 seconds per round</figcaption>
            </figure>
            <figure class="password-shot-card">
              <img
                class="password-shot"
                src="/assets/password-game/screenshot-rules.jpg"
                alt="Password game : duel screenshot explaining the one word guessing rule"
                width="416"
                height="900"
                loading="lazy"
              />
              <figcaption>One word each</figcaption>
            </figure>
          </div>
          <div class="password-gallery-controls" aria-label="Screenshot controls">
            <button type="button" class="password-gallery-button" data-gallery-prev aria-label="Previous screenshot">
              <span aria-hidden="true">&larr;</span>
            </button>
            <p>Swipe to view all 3</p>
            <button type="button" class="password-gallery-button" data-gallery-next aria-label="Next screenshot">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(760px 520px at 22% 18%, rgba(98, 0, 255, 0.38), transparent 62%),
        radial-gradient(760px 520px at 86% 80%, rgba(216, 255, 0, 0.14), transparent 62%),
        linear-gradient(160deg, #090019 0%, #12002b 42%, #05000d 100%);
    }

    :global(body)::before {
      opacity: 0.1;
    }

    .password-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: clamp(24px, 5vw, 72px);
    }

    .password-hero {
      width: min(1120px, 100%);
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
      align-items: center;
      gap: clamp(32px, 6vw, 72px);
    }

    .password-copy {
      animation: fadeUp 0.8s ease both;
    }

    .password-kicker {
      width: fit-content;
      margin: 0 0 18px;
      border: 1px solid rgba(216, 255, 0, 0.36);
      border-radius: 999px;
      padding: 8px 12px;
      color: #d8ff00;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      background: rgba(216, 255, 0, 0.08);
    }

    h1 {
      margin: 0;
      max-width: 760px;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: clamp(52px, 9vw, 112px);
      font-weight: 900;
      letter-spacing: -0.07em;
      line-height: 0.9;
      color: #fff;
      text-shadow:
        0 0 26px rgba(98, 0, 255, 0.55),
        0 18px 60px rgba(0, 0, 0, 0.65);
    }

    .password-subtitle {
      max-width: 620px;
      margin: clamp(20px, 3vw, 30px) 0 0;
      color: #f5f0ff;
      font-size: clamp(1.35rem, 2.4vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.06;
    }

    .password-description {
      max-width: 600px;
      margin: 18px 0 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: clamp(1rem, 1.4vw, 1.18rem);
      line-height: 1.65;
    }

    .password-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: clamp(26px, 4vw, 40px);
    }

    .password-cta,
    .password-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      border-radius: 999px;
      padding: 0 22px;
      font-size: 0.82rem;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .password-cta {
      color: #15002e;
      background: linear-gradient(135deg, #d8ff00, #b9f52e, #ecff6b);
      box-shadow:
        0 16px 42px rgba(0, 0, 0, 0.42),
        0 12px 34px rgba(216, 255, 0, 0.23);
    }

    .password-link {
      color: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(14px);
    }

    .password-cta:hover,
    .password-link:hover {
      transform: translateY(-2px);
    }

    .password-cta:hover {
      box-shadow:
        0 20px 54px rgba(0, 0, 0, 0.5),
        0 18px 42px rgba(216, 255, 0, 0.32);
    }

    .password-link:hover {
      border-color: rgba(216, 255, 0, 0.45);
    }

    .password-showcase {
      position: relative;
      width: 100%;
      display: grid;
      place-items: center;
      isolation: isolate;
      animation: fadeUp 0.8s 0.12s ease both;
    }

    .password-showcase::before {
      content: "";
      position: absolute;
      width: min(520px, 90vw);
      aspect-ratio: 1;
      border-radius: 999px;
      background:
        radial-gradient(circle, rgba(216, 255, 0, 0.2), transparent 58%),
        radial-gradient(circle, rgba(98, 0, 255, 0.34), transparent 68%);
      filter: blur(8px);
      opacity: 0.9;
      z-index: -1;
    }

    .password-gallery-shell {
      width: min(590px, 100%);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: clamp(28px, 4vw, 40px);
      padding: clamp(14px, 2.6vw, 20px);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04)),
        rgba(12, 0, 31, 0.62);
      box-shadow:
        0 30px 86px rgba(0, 0, 0, 0.5),
        0 0 60px rgba(98, 0, 255, 0.18);
      backdrop-filter: blur(18px);
    }

    .password-gallery-topline,
    .password-gallery-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .password-gallery-topline {
      margin-bottom: 12px;
      padding: 0 4px;
    }

    .password-gallery-topline p,
    .password-gallery-topline span,
    .password-gallery-controls p,
    .password-shot-card figcaption {
      margin: 0;
      font-size: 0.68rem;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .password-gallery-topline p,
    .password-shot-card figcaption {
      color: rgba(255, 255, 255, 0.72);
    }

    .password-gallery-topline span,
    .password-gallery-controls p {
      color: #d8ff00;
    }

    .password-gallery {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding: 10px;
      scroll-snap-type: x mandatory;
      padding: 8px 10px 18px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .password-gallery::-webkit-scrollbar {
      display: none;
    }

    .password-gallery:focus-visible {
      outline: 2px solid #d8ff00;
      outline-offset: 4px;
      border-radius: 28px;
    }

    .password-shot-card {
      flex: 0 0 min(300px, 78%);
      scroll-snap-align: center;
      margin: 0;
      display: grid;
      gap: 10px;
    }

    .password-shot {
      width: 100%;
      height: auto;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: clamp(24px, 4vw, 38px);
      background: #05000d;
      box-shadow:
        0 24px 68px rgba(0, 0, 0, 0.58),
        0 0 44px rgba(98, 0, 255, 0.22);
    }

    .password-gallery-controls {
      padding: 0 4px;
    }

    .password-gallery-button {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border: 1px solid rgba(216, 255, 0, 0.36);
      border-radius: 999px;
      color: #15002e;
      background: linear-gradient(135deg, #d8ff00, #b9f52e);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32);
      cursor: pointer;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .password-gallery-button:hover {
      transform: translateY(-2px);
      box-shadow:
        0 16px 34px rgba(0, 0, 0, 0.4),
        0 0 22px rgba(216, 255, 0, 0.2);
    }

    .password-gallery-button:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 840px) {
      .password-hero {
        grid-template-columns: 1fr;
      }

      .password-copy {
        text-align: center;
      }

      .password-kicker,
      .password-actions {
        margin-left: auto;
        margin-right: auto;
        justify-content: center;
      }

      .password-description,
      .password-subtitle {
        margin-left: auto;
        margin-right: auto;
      }

      .password-gallery-shell {
        width: min(500px, 100%);
      }

      .password-shot-card {
        flex-basis: min(286px, 76%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .password-copy,
      .password-showcase {
        animation: none;
      }
    }
  </style>
  <script is:inline>
    const gallery = document.querySelector("[data-password-gallery]");
    const previousButton = document.querySelector("[data-gallery-prev]");
    const nextButton = document.querySelector("[data-gallery-next]");

    const scrollGallery = (direction) => {
      if (!gallery) return;

      const card = gallery.querySelector(".password-shot-card");
      const cardWidth = card ? card.getBoundingClientRect().width : gallery.clientWidth * 0.82;
      gallery.scrollBy({
        left: direction * (cardWidth + 18),
        behavior: "smooth",
      });
    };

    previousButton?.addEventListener("click", () => scrollGallery(-1));
    nextButton?.addEventListener("click", () => scrollGallery(1));
  </script>
</SimpleLayout>
