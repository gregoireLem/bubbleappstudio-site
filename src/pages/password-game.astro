---
import SimpleLayout from "../layouts/SimpleLayout.astro";

const description = "Password Game : Duel, the TV-style word duel game on your phone.";
const appStoreUrl = "https://apps.apple.com/app/id6762822222";
---

<SimpleLayout
  title="Password Game : Duel | Bubble App Studio"
  description={description}
  themeColor="#12002b"
>
  <main id="main" class="password-page">
    <section class="password-hero" aria-labelledby="password-title">
      <div class="password-copy">
        <p class="password-kicker">Bubble App Studio</p>
        <h1 id="password-title">Password Game : Duel</h1>
        <p class="password-subtitle">The TV-style word duel game on your phone.</p>
        <p class="password-description">
          Hold the phone, record both players, and race to guess as many passwords as possible in 30 seconds.
          One clue, one answer, back and forth until the password is found.
        </p>

        <div class="password-actions">
          <a class="password-cta" href={appStoreUrl} target="_blank" rel="noreferrer">
            View on App Store
          </a>
          <a class="password-link" href="/password-game/privacy">Privacy policy</a>
        </div>
      </div>

      <div class="password-card" aria-label="Gameplay example">
        <div class="password-phone">
          <div class="password-camera password-camera-top">
            <span>Player 1</span>
          </div>
          <div class="password-word">MARIO</div>
          <div class="password-camera password-camera-bottom">
            <span>Player 2</span>
          </div>
          <div class="password-controls">
            <span>Skip</span>
            <span>Validate</span>
          </div>
        </div>
        <div class="password-example">
          <p>Password: <strong>Mario</strong></p>
          <p>Player 1: plumber</p>
          <p>Player 2: sink</p>
          <p>Player 1: mushroom</p>
          <p>Player 2: <strong>Mario!</strong></p>
        </div>
      </div>
    </section>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(760px 520px at 22% 18%, rgba(98, 0, 255, 0.38), transparent 62%),
        radial-gradient(760px 520px at 86% 80%, rgba(216, 255, 0, 0.14), transparent 62%),
        linear-gradient(160deg, #090019 0%, #12002b 42%, #05000d 100%);
    }

    :global(body)::before {
      opacity: 0.1;
    }

    .password-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: clamp(24px, 5vw, 72px);
    }

    .password-hero {
      width: min(1120px, 100%);
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
      align-items: center;
      gap: clamp(32px, 6vw, 72px);
    }

    .password-copy {
      animation: fadeUp 0.8s ease both;
    }

    .password-kicker {
      width: fit-content;
      margin: 0 0 18px;
      border: 1px solid rgba(216, 255, 0, 0.36);
      border-radius: 999px;
      padding: 8px 12px;
      color: #d8ff00;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      background: rgba(216, 255, 0, 0.08);
    }

    h1 {
      margin: 0;
      max-width: 760px;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: clamp(52px, 9vw, 112px);
      font-weight: 900;
      letter-spacing: -0.07em;
      line-height: 0.9;
      color: #fff;
      text-shadow:
        0 0 26px rgba(98, 0, 255, 0.55),
        0 18px 60px rgba(0, 0, 0, 0.65);
    }

    .password-subtitle {
      max-width: 620px;
      margin: clamp(20px, 3vw, 30px) 0 0;
      color: #f5f0ff;
      font-size: clamp(1.35rem, 2.4vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.06;
    }

    .password-description {
      max-width: 600px;
      margin: 18px 0 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: clamp(1rem, 1.4vw, 1.18rem);
      line-height: 1.65;
    }

    .password-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: clamp(26px, 4vw, 40px);
    }

    .password-cta,
    .password-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      border-radius: 999px;
      padding: 0 22px;
      font-size: 0.82rem;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .password-cta {
      color: #15002e;
      background: linear-gradient(135deg, #d8ff00, #b9f52e, #ecff6b);
      box-shadow:
        0 16px 42px rgba(0, 0, 0, 0.42),
        0 12px 34px rgba(216, 255, 0, 0.23);
    }

    .password-link {
      color: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(14px);
    }

    .password-cta:hover,
    .password-link:hover {
      transform: translateY(-2px);
    }

    .password-cta:hover {
      box-shadow:
        0 20px 54px rgba(0, 0, 0, 0.5),
        0 18px 42px rgba(216, 255, 0, 0.32);
    }

    .password-link:hover {
      border-color: rgba(216, 255, 0, 0.45);
    }

    .password-card {
      display: grid;
      justify-items: center;
      gap: 18px;
      animation: fadeUp 0.8s 0.12s ease both;
    }

    .password-phone {
      position: relative;
      width: min(320px, 70vw);
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border: 10px solid rgba(255, 255, 255, 0.1);
      border-radius: 42px;
      background: #0d0620;
      box-shadow:
        0 32px 90px rgba(0, 0, 0, 0.58),
        0 0 0 1px rgba(255, 255, 255, 0.12),
        0 0 80px rgba(98, 0, 255, 0.36);
    }

    .password-camera {
      position: absolute;
      left: 0;
      right: 0;
      height: 50%;
      display: grid;
      place-items: center;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .password-camera-top {
      top: 0;
      background:
        linear-gradient(165deg, rgba(98, 0, 255, 0.5), rgba(46, 0, 153, 0.16)),
        radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.16), transparent 26%),
        #14003c;
    }

    .password-camera-bottom {
      bottom: 0;
      background:
        linear-gradient(20deg, rgba(46, 0, 153, 0.72), rgba(98, 0, 255, 0.2)),
        radial-gradient(circle at 70% 70%, rgba(216, 255, 0, 0.16), transparent 26%),
        #090019;
    }

    .password-phone::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
      background: rgba(255, 255, 255, 0.22);
    }

    .password-word {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 50%;
      width: 82%;
      transform: translate(-50%, -50%);
      border: 2px solid #d8ff00;
      border-radius: 22px;
      padding: 19px 18px;
      color: #fff;
      background: linear-gradient(135deg, #6200ff, #2e0099);
      text-align: center;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: clamp(1.7rem, 6vw, 2.25rem);
      font-weight: 900;
      letter-spacing: 0.08em;
      box-shadow:
        0 18px 42px rgba(0, 0, 0, 0.45),
        0 0 24px rgba(216, 255, 0, 0.18);
    }

    .password-controls {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 22px;
      display: flex;
      justify-content: space-between;
      color: rgba(255, 255, 255, 0.74);
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .password-controls span {
      display: grid;
      place-items: center;
      width: 74px;
      height: 74px;
      border-radius: 999px;
      background: rgba(216, 255, 0, 0.92);
      color: #16002f;
    }

    .password-controls span:first-child {
      background: rgba(46, 0, 153, 0.95);
      color: #fff;
    }

    .password-example {
      width: min(380px, 100%);
      border: 1px solid rgba(255, 255, 255, 0.11);
      border-radius: 28px;
      padding: 18px 20px;
      color: rgba(255, 255, 255, 0.78);
      background: rgba(255, 255, 255, 0.07);
      box-shadow: 0 18px 52px rgba(0, 0, 0, 0.22);
      backdrop-filter: blur(18px);
    }

    .password-example p {
      margin: 6px 0;
      line-height: 1.35;
    }

    .password-example strong {
      color: #d8ff00;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 840px) {
      .password-hero {
        grid-template-columns: 1fr;
      }

      .password-copy {
        text-align: center;
      }

      .password-kicker,
      .password-actions {
        margin-left: auto;
        margin-right: auto;
        justify-content: center;
      }

      .password-description,
      .password-subtitle {
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .password-copy,
      .password-card {
        animation: none;
      }
    }
  </style>
</SimpleLayout>
