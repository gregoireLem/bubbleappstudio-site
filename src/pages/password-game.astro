---
import SimpleLayout from "../layouts/SimpleLayout.astro";

const description = "Password Game : Duel, the TV-style word duel game on your phone.";
const appStoreUrl = "https://apps.apple.com/app/id6762822222";
---

<SimpleLayout
  title="Password Game : Duel | Bubble App Studio"
  description={description}
  themeColor="#12002b"
>
  <main id="main" class="password-page">
    <section class="password-hero" aria-labelledby="password-title">
      <div class="password-copy">
        <p class="password-kicker">Bubble App Studio</p>
        <h1 id="password-title">Password Game : Duel</h1>
        <p class="password-subtitle">The TV-style word duel game on your phone.</p>
        <p class="password-description">
          Hold the phone, record both players, and race to guess as many passwords as possible in 30 seconds.
          One clue, one answer, back and forth until the password is found.
        </p>

        <div class="password-actions">
          <a class="password-cta" href={appStoreUrl} target="_blank" rel="noreferrer">
            View on App Store
          </a>
          <a class="password-link" href="/password-game/privacy">Privacy policy</a>
        </div>
      </div>

      <div class="password-showcase" aria-label="Password Game : Duel App Store screenshots">
        <img
          class="password-shot password-shot-left"
          src="/assets/password-game/screenshot-connected.jpg"
          alt="Password Game : Duel gameplay screenshot showing two camera feeds and the word SpongeBob"
          width="416"
          height="900"
          loading="lazy"
        />
        <img
          class="password-shot password-shot-main"
          src="/assets/password-game/screenshot-timer.jpg"
          alt="Password Game : Duel gameplay screenshot showing a 30 second round"
          width="416"
          height="900"
          loading="eager"
        />
        <img
          class="password-shot password-shot-right"
          src="/assets/password-game/screenshot-rules.jpg"
          alt="Password Game : Duel screenshot explaining the one word guessing rule"
          width="416"
          height="900"
          loading="lazy"
        />
      </div>
    </section>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(760px 520px at 22% 18%, rgba(98, 0, 255, 0.38), transparent 62%),
        radial-gradient(760px 520px at 86% 80%, rgba(216, 255, 0, 0.14), transparent 62%),
        linear-gradient(160deg, #090019 0%, #12002b 42%, #05000d 100%);
    }

    :global(body)::before {
      opacity: 0.1;
    }

    .password-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: clamp(24px, 5vw, 72px);
    }

    .password-hero {
      width: min(1120px, 100%);
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
      align-items: center;
      gap: clamp(32px, 6vw, 72px);
    }

    .password-copy {
      animation: fadeUp 0.8s ease both;
    }

    .password-kicker {
      width: fit-content;
      margin: 0 0 18px;
      border: 1px solid rgba(216, 255, 0, 0.36);
      border-radius: 999px;
      padding: 8px 12px;
      color: #d8ff00;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      background: rgba(216, 255, 0, 0.08);
    }

    h1 {
      margin: 0;
      max-width: 760px;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: clamp(52px, 9vw, 112px);
      font-weight: 900;
      letter-spacing: -0.07em;
      line-height: 0.9;
      color: #fff;
      text-shadow:
        0 0 26px rgba(98, 0, 255, 0.55),
        0 18px 60px rgba(0, 0, 0, 0.65);
    }

    .password-subtitle {
      max-width: 620px;
      margin: clamp(20px, 3vw, 30px) 0 0;
      color: #f5f0ff;
      font-size: clamp(1.35rem, 2.4vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.06;
    }

    .password-description {
      max-width: 600px;
      margin: 18px 0 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: clamp(1rem, 1.4vw, 1.18rem);
      line-height: 1.65;
    }

    .password-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: clamp(26px, 4vw, 40px);
    }

    .password-cta,
    .password-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      border-radius: 999px;
      padding: 0 22px;
      font-size: 0.82rem;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .password-cta {
      color: #15002e;
      background: linear-gradient(135deg, #d8ff00, #b9f52e, #ecff6b);
      box-shadow:
        0 16px 42px rgba(0, 0, 0, 0.42),
        0 12px 34px rgba(216, 255, 0, 0.23);
    }

    .password-link {
      color: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(14px);
    }

    .password-cta:hover,
    .password-link:hover {
      transform: translateY(-2px);
    }

    .password-cta:hover {
      box-shadow:
        0 20px 54px rgba(0, 0, 0, 0.5),
        0 18px 42px rgba(216, 255, 0, 0.32);
    }

    .password-link:hover {
      border-color: rgba(216, 255, 0, 0.45);
    }

    .password-showcase {
      position: relative;
      min-height: min(690px, 78vw);
      place-items: center;
      display: grid;
      isolation: isolate;
      animation: fadeUp 0.8s 0.12s ease both;
    }

    .password-showcase::before {
      content: "";
      position: absolute;
      width: min(520px, 90vw);
      aspect-ratio: 1;
      border-radius: 999px;
      background:
        radial-gradient(circle, rgba(216, 255, 0, 0.2), transparent 58%),
        radial-gradient(circle, rgba(98, 0, 255, 0.34), transparent 68%);
      filter: blur(8px);
      opacity: 0.9;
      z-index: -1;
    }

    .password-shot {
      width: min(250px, 34vw);
      height: auto;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: clamp(24px, 4vw, 42px);
      background: #05000d;
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.58),
        0 0 44px rgba(98, 0, 255, 0.22);
    }

    .password-shot-main {
      z-index: 3;
      width: min(300px, 42vw);
      transform: translateY(-6px);
      box-shadow:
        0 34px 92px rgba(0, 0, 0, 0.66),
        0 0 54px rgba(216, 255, 0, 0.16),
        0 0 80px rgba(98, 0, 255, 0.28);
    }

    .password-shot-left,
    .password-shot-right {
      position: absolute;
      z-index: 1;
      opacity: 0.82;
      filter: saturate(0.95) brightness(0.82);
    }

    .password-shot-left {
      transform: translateX(-42%) rotate(-8deg) scale(0.92);
    }

    .password-shot-right {
      transform: translateX(42%) rotate(8deg) scale(0.92);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 840px) {
      .password-hero {
        grid-template-columns: 1fr;
      }

      .password-copy {
        text-align: center;
      }

      .password-kicker,
      .password-actions {
        margin-left: auto;
        margin-right: auto;
        justify-content: center;
      }

      .password-description,
      .password-subtitle {
        margin-left: auto;
        margin-right: auto;
      }

      .password-showcase {
        min-height: min(620px, 138vw);
      }

      .password-shot-main {
        width: min(286px, 58vw);
      }

      .password-shot-left,
      .password-shot-right {
        width: min(220px, 42vw);
      }

      .password-shot-left {
        transform: translate(-35%, 22px) rotate(-7deg) scale(0.88);
      }

      .password-shot-right {
        transform: translate(35%, 22px) rotate(7deg) scale(0.88);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .password-copy,
      .password-showcase {
        animation: none;
      }
    }
  </style>
</SimpleLayout>
