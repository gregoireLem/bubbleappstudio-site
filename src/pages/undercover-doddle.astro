---
import SimpleLayout from "../layouts/SimpleLayout.astro";
---

<SimpleLayout
  title="Redirecting | Undercover : Doodle"
  description="Redirecting to the Undercover : Doodle landing page."
  robots="noindex, follow"
  themeColor="#090119"
  icon="/assets/undercover-doodle/app-icon.png"
  lang="en"
  locale="en_US"
>
  <main id="main" class="redirect-page">
    <script is:inline>
      window.location.replace("/undercover-doodle/");
    </script>
    <section class="redirect-card">
      <h1>Redirecting…</h1>
      <p>
        The landing page is now available at
        <a href="/undercover-doodle/">/undercover-doodle/</a>.
      </p>
    </section>
  </main>

  <style>
    .redirect-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .redirect-card {
      width: min(640px, 100%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(10, 4, 24, 0.74);
      padding: 32px;
      text-align: center;
    }

    h1 {
      margin: 0 0 12px;
      color: #fff;
      font-size: clamp(28px, 5vw, 42px);
    }

    p {
      margin: 0;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.65;
    }

    a {
      color: #ffe600;
      text-underline-offset: 4px;
    }
  </style>
</SimpleLayout>
