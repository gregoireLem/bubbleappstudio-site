---
import SimpleLayout from "../../layouts/SimpleLayout.astro";

const description = "Support for Multiplication Tables: Oral Trainer.";
---

<SimpleLayout
  title="Support | Multiplication Tables: Oral Trainer"
  description={description}
  robots="index, follow"
  themeColor="#4635B1"
  ogImage="/assets/math-tabs/app-icon.png"
  lang="en"
  locale="en_US"
  colorScheme="light"
  icon="/assets/math-tabs/app-icon.png"
>
  <main id="main" class="legal-page">
    <article class="legal-card">
      <p class="legal-kicker">Multiplication Tables: Oral Trainer</p>
      <h1>Support</h1>
      <p class="legal-date">Last updated: May 18, 2026</p>

      <h2>Contact</h2>
      <p>
        For support, questions, or purchase issues, contact
        <a href="mailto:contact@bubbleappstudio.xyz">contact@bubbleappstudio.xyz</a>.
      </p>

      <h2>What the app does</h2>
      <p>
        Multiplication Tables: Oral Trainer helps children practice multiplication tables out loud.
        The app reads the question aloud, listens for the spoken answer, and corrects mistakes immediately.
      </p>

      <h2>Common help topics</h2>
      <p><strong>Microphone access:</strong> The app needs microphone access to hear spoken answers.</p>
      <p><strong>Speech recognition access:</strong> The app needs speech recognition access to validate spoken answers.</p>
      <p><strong>Restore purchases:</strong> Use the Restore Purchases button on the subscription screen if you already paid.</p>

      <h2>Languages</h2>
      <p>The app currently supports English and French.</p>

      <h2>Legal links</h2>
      <p><a href="/math-tabs/privacy">Privacy Policy</a></p>
      <p><a href="/math-tabs/eula">Terms of Use (EULA)</a></p>
    </article>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(760px 520px at 50% 0%, rgba(91, 77, 224, 0.24), transparent 64%),
        radial-gradient(680px 460px at 85% 90%, rgba(174, 234, 148, 0.18), transparent 66%),
        #faf8ff;
      color: #171122;
    }

    :global(body)::before {
      opacity: 0.08;
      mix-blend-mode: multiply;
    }

    .legal-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: clamp(28px, 6vw, 72px);
    }

    .legal-card {
      width: min(920px, 100%);
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(70, 53, 177, 0.1);
      border-radius: 28px;
      padding: clamp(24px, 4vw, 48px);
      box-shadow: 0 24px 70px rgba(70, 53, 177, 0.10);
      backdrop-filter: blur(18px);
    }

    .legal-kicker {
      text-transform: uppercase;
      letter-spacing: 0.24em;
      font-size: 0.74rem;
      color: #4635b1;
      margin: 0 0 12px;
      font-weight: 900;
    }

    .legal-date {
      color: rgba(23, 17, 34, 0.52);
      margin-top: 0;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(34px, 5vw, 54px);
      margin: 0 0 8px;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 900;
      letter-spacing: -0.05em;
      color: #171122;
    }

    h2 {
      margin-top: 28px;
      margin-bottom: 8px;
      font-size: 1.08rem;
      color: #4635b1;
    }

    p,
    li {
      color: rgba(23, 17, 34, 0.78);
      line-height: 1.7;
    }

    a {
      color: #4635b1;
      text-underline-offset: 4px;
    }
  </style>
</SimpleLayout>
