---
import SimpleLayout from "../../layouts/SimpleLayout.astro";

const description = "End User License Agreement (EULA) for Undercover : Doodle.";
---

<SimpleLayout
  title="EULA | Undercover : Doodle"
  description={description}
  robots="index, follow"
  themeColor="#090119"
  icon="/assets/undercover-doodle/app-icon.png"
  lang="en"
  locale="en_US"
>
  <main id="main" class="legal-page">
    <article class="legal-card">
      <p class="legal-kicker">Undercover : Doodle</p>
      <h1>End User License Agreement (EULA)</h1>
      <p class="legal-date">Last updated: May 23, 2026</p>

      <p>
        This app uses the standard Apple Terms of Use (EULA). You can read them here:
      </p>
      <p>
        <a
          href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/"
          rel="noreferrer"
          target="_blank"
        >
          Apple Standard EULA
        </a>
      </p>
    </article>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(760px 520px at 50% 0%, rgba(255, 230, 0, 0.14), transparent 64%),
        radial-gradient(680px 460px at 85% 90%, rgba(90, 60, 255, 0.14), transparent 66%),
        #070010;
    }

    :global(body)::before {
      opacity: 0.08;
    }

    .legal-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: clamp(28px, 6vw, 72px);
    }

    .legal-card {
      width: min(900px, 100%);
      background: rgba(12, 0, 31, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 28px;
      padding: clamp(24px, 4vw, 48px);
      box-shadow:
        0 24px 70px rgba(0, 0, 0, 0.5),
        0 0 48px rgba(255, 230, 0, 0.08);
      backdrop-filter: blur(18px);
    }

    .legal-kicker {
      text-transform: uppercase;
      letter-spacing: 0.28em;
      font-size: 0.72rem;
      color: #ffe600;
      margin: 0 0 12px;
    }

    .legal-date {
      color: rgba(255, 255, 255, 0.58);
      margin-top: 0;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(34px, 5vw, 54px);
      margin: 0 0 8px;
      font-family: "SF Pro Rounded", "SF Pro Display", "SF Pro Text", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 900;
      letter-spacing: -0.05em;
      color: #fff;
    }

    p,
    li {
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.65;
    }

    a {
      color: #ffe600;
      text-underline-offset: 4px;
    }
  </style>
</SimpleLayout>
