---
import Hero from "./Hero";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import LocalePrompt from "./LocalePrompt.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCards from "./BlogCards.astro";
import { blogCopy, blogPaths, postsFor } from "../lib/blog";
import "../styles/blog.css";
import {
  buildAlternateLinks,
  defaultLocale,
  getLocalizedPath,
  homePageContent,
  localeMeta,
  type Locale
} from "../i18n/site";

const { locale } = Astro.props as { locale: Locale };
const content = homePageContent[locale];
const meta = localeMeta[locale];
const schemaData = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Loup-garou Undercover",
  applicationCategory: "Game",
  operatingSystem: "iOS, Android",
  description: content.metaDescription,
  url: new URL(getLocalizedPath(locale, "/"), "https://www.bubbleappstudio.xyz").toString(),
  inLanguage: meta.lang,
  sameAs: [
    "https://apps.apple.com/app/id6740009341",
    "https://play.google.com/store/apps/details?id=xyz.bubbleappstudio.werewolfundercover&pcampaignid=web_share"
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR"
  },
  publisher: {
    "@type": "Organization",
    name: "Bubble App Studio",
    url: "https://www.bubbleappstudio.xyz"
  }
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  lang={meta.lang}
  locale={meta.ogLocale}
  alternates={buildAlternateLinks("/")}
  skipLinkLabel={content.skipLinkLabel}
  schemaData={schemaData}
>
  <main id="main" class="relative">
    {locale === defaultLocale && (
      <LocalePrompt
        copy={{
          ariaLabel: "Language suggestion",
          messagePrefix: "This page is also available in",
          openLabel: "Open",
          dismissLabel: "Dismiss language suggestion"
        }}
      />
    )}
    <div class="absolute inset-x-0 top-0 z-20">
      <div class="container-base flex items-center justify-end gap-5 pt-6 sm:pt-8">
        <a href={blogPaths[locale]} class="text-sm font-semibold hover:text-[var(--accent-yellow)]">Blog</a>
        <LocaleSwitcher currentLocale={locale} path="/" label={content.localeSwitcherLabel} />
      </div>
    </div>
    <Hero
      client:visible
      content={content}
    />
    <section class="container-base blog-home-section" aria-labelledby="blog-heading">
      <div class="blog-home-heading">
        <div><p class="blog-eyebrow">{blogCopy[locale].label}</p><h2 id="blog-heading">{blogCopy[locale].title}</h2></div>
        <a href={blogPaths[locale]}>{blogCopy[locale].all} <span aria-hidden="true">↗</span></a>
      </div>
      <BlogCards posts={postsFor(locale)} locale={locale} />
    </section>
  </main>
  <footer class="blog-footer container-base">
    <p>{content.footerCopy}</p>
    <nav aria-label={content.termsLabel}>
      <a href={getLocalizedPath(locale, "/terms")}>{content.termsLabel}</a>
      <a href={getLocalizedPath(locale, "/privacy")}>{content.privacyLabel}</a>
    </nav>
  </footer>
</BaseLayout>
