---
import LocaleSwitcher from "./LocaleSwitcher.astro";
import SimpleLayout from "../layouts/SimpleLayout.astro";
import {
  buildAlternateLinks,
  localeMeta,
  type LegalPageContent,
  type Locale
} from "../i18n/site";

const { locale, path, content } = Astro.props as {
  locale: Locale;
  path: string;
  content: LegalPageContent;
};

const meta = localeMeta[locale];
---

<SimpleLayout
  title={content.metaTitle}
  description={content.metaDescription}
  robots="index, follow"
  lang={meta.lang}
  locale={meta.ogLocale}
  alternates={buildAlternateLinks(path)}
  skipLinkLabel={content.skipLinkLabel}
>
  <main id="main" class="legal-page">
    <div class="legal-shell">
      <div class="legal-toolbar">
        <LocaleSwitcher currentLocale={locale} path={path} label={content.localeSwitcherLabel} />
      </div>

      <article class="legal-card">
        <p class="legal-kicker">{content.kicker}</p>
        <h1>{content.title}</h1>
        <p class="legal-date">{content.updatedLabel}: {content.updatedAt}</p>

        {content.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}
            {section.list && (
              <ul>
                {section.list.map((item) => <li set:html={item} />)}
              </ul>
            )}
          </section>
        ))}
      </article>
    </div>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(700px 500px at 50% 0%, rgba(251, 234, 78, 0.12), transparent 65%),
        #050505;
    }

    :global(body)::before {
      opacity: 0.08;
    }

    .legal-page {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: clamp(28px, 6vw, 72px);
    }

    .legal-shell {
      width: min(860px, 100%);
    }

    .legal-toolbar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 16px;
    }

    .legal-card {
      width: 100%;
      background: rgba(10, 10, 10, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: clamp(24px, 4vw, 48px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    }

    .legal-kicker {
      text-transform: uppercase;
      letter-spacing: 0.32em;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.6);
      margin: 0 0 12px;
    }

    .legal-date {
      color: rgba(255, 255, 255, 0.6);
      margin-top: 0;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(32px, 5vw, 48px);
      margin: 0 0 8px;
      font-family: "SF Pro Display", "SF Pro Text", -apple-system, BlinkMacSystemFont,
        "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 700;
    }

    h2 {
      margin-top: 28px;
      margin-bottom: 8px;
      font-size: 1.1rem;
      color: #f7f1d6;
    }

    p,
    li {
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.6;
    }

    ul {
      padding-left: 20px;
      margin-top: 8px;
      margin-bottom: 16px;
    }

    a {
      color: #fbea4e;
      text-underline-offset: 4px;
    }
  </style>
</SimpleLayout>
