---
import "../styles/global.css";
import type { AlternateLink } from "../i18n/site";

const {
  title = "Bubble App Studio",
  description = "Bubble App Studio",
  ogImage = "/assets/wolfo.png",
  robots = "index, follow",
  themeColor = "#050505",
  bodyClass = "",
  lang = "fr",
  locale = "fr_FR",
  colorScheme = "dark",
  icon = "/assets/wolfo.png",
  alternates = [],
  skipLinkLabel = "Skip to content"
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.bubbleappstudio.xyz";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`;
const alternateOgLocales = Array.from(
  new Set(
    (alternates as AlternateLink[])
      .filter((alternate) => alternate.locale && alternate.locale !== locale)
      .map((alternate) => alternate.locale as string)
  )
);
const fontFaceCss = `@font-face {
  font-family: "Dela Gothic One";
  src: url("${baseUrl}fonts/DelaGothicOne-Regular.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    {(alternates as AlternateLink[]).map((alternate) => (
      <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
    ))}
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={colorScheme} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    {alternateOgLocales.map((alternateLocale) => (
      <meta property="og:locale:alternate" content={alternateLocale} />
    ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href={icon.startsWith("http") ? icon : `${baseUrl}${icon.startsWith("/") ? icon.slice(1) : icon}`} />
    <title>{title}</title>
  </head>
  <body class={`antialiased ${bodyClass}`.trim()}>
    <style is:global set:html={fontFaceCss} />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-6 focus:top-6 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-slate-900">
      {skipLinkLabel}
    </a>
    <slot />
  </body>
</html>
