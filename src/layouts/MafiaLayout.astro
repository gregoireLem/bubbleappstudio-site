---
const { title, description } = Astro.props;
const base = '/mafia/';
const eula = 'https://www.apple.com/legal/internet-services/itunes/dev/stdeula/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Mafia — Bubble App Studio</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b13" />
    <link rel="icon" href="/assets/mafia/icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={base}><img src="/assets/mafia/icon.png" alt="" width="48" height="48" /><span>MAFIA<small>by Bubble App Studio</small></span></a>
      <nav aria-label="Main navigation"><a href={base + 'support/'}>Support</a><a href={base + 'privacy/'}>Privacy</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer><span>© 2026 Bubble App Studio</span><a href={base + 'support/'}>Contact & support</a><a href={base + 'privacy/'}>Privacy Policy</a><a href={eula}>Terms of Use (Apple EULA)</a></footer>
  </body>
</html>
<style is:global>
  :root{color-scheme:dark;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0c0b13;color:#f8f5f2;line-height:1.7}
  *{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 10% 0%,#361320 0,transparent 55%),radial-gradient(ellipse at 100% 100%,#161f38 0,transparent 50%);min-height:100vh}
  a{color:#f5cf82;text-underline-offset:4px}a:hover{color:#fff}a:focus-visible{outline:3px solid #f5cf82;outline-offset:5px;border-radius:4px}
  header,main,footer{width:min(900px,calc(100% - 40px));margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:28px 0 40px}
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:white;font-weight:900;letter-spacing:.1em;line-height:1.3}.brand img{border-radius:12px}.brand small{display:block;color:#bdb4c1;font-size:11px;font-weight:500;letter-spacing:0}
  nav{display:flex;gap:20px;font-size:14px}main{min-height:60vh;padding:32px clamp(20px,5vw,56px);background:#14111be6;border:1px solid #ffffff14;border-radius:28px}
  h1{font-size:clamp(34px,6vw,58px);line-height:1.1;letter-spacing:-.04em;margin:10px 0 24px}h2{font-size:22px;line-height:1.3;margin:36px 0 12px;color:#fff}p,li{color:#d0c8d3}ul{padding-left:24px}.eyebrow{color:#f5cf82;text-transform:uppercase;font-size:12px;letter-spacing:.2em;font-weight:700}.updated{font-size:14px;color:#a99fae}
  .lead{font-size:20px}.actions{display:flex;gap:14px;flex-wrap:wrap;margin:28px 0}.button{display:inline-block;border:1px solid #ffffff24;border-radius:14px;padding:12px 22px;text-decoration:none;font-weight:650}.primary{background:#c62d40;color:white;border-color:#f3656f}.contact{overflow-wrap:anywhere}
  footer{display:flex;flex-wrap:wrap;gap:12px 22px;padding:30px 0 40px;font-size:12px;color:#a99fae}.skip{position:absolute;left:-10000px}.skip:focus{left:16px;top:8px;background:#0c0b13;padding:8px;z-index:5}
  @media(max-width:480px){header{align-items:flex-start}nav{gap:12px}main{border-radius:20px}.brand small{max-width:95px}.contact{font-size:15px}}
</style>
